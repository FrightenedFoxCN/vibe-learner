              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Manifest Key"
          },
          "canonical_name": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_]{0,79}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Canonical Name"
          },
          "input_contract_version": {
            "anyOf": [
              {
                "maxLength": 160,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Input Contract Version"
          },
          "result_contract_version": {
            "anyOf": [
              {
                "maxLength": 160,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result Contract Version"
          },
          "provider_tool_call_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_-]{1,160}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Provider Tool Call Id"
          },
          "max_calls_per_operation": {
            "anyOf": [
              {
                "maximum": 64,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Calls Per Operation"
          },
          "max_calls_per_round": {
            "anyOf": [
              {
                "maximum": 8,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Calls Per Round"
          },
          "timeout_ms": {
            "anyOf": [
              {
                "maximum": 120000,
                "minimum": 100,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timeout Ms"
          },
          "manifest_gap": {
            "anyOf": [
              {
                "const": "unregistered_tool",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Manifest Gap"
          },
          "effect_commit_claim": {
            "const": "none",
            "default": "none",
            "title": "Effect Commit Claim",
            "type": "string"
          }
        },
        "required": [
          "workflow",
          "offered_in_stage"
        ],
        "title": "DiagnosticToolMetricV1",
        "type": "object"
      },
      "HarnessAttemptPhase": {
        "enum": [
          "generate",
          "decode",
          "validate",
          "repair",
          "commit",
          "rollback"
