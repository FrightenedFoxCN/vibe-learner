        ],
        "default": null,
        "title": "Action Name"
      },
      "span_id": {
        "anyOf": [
          {
            "pattern": "^[a-zA-Z0-9_-]{1,96}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Span Id"
      },
      "parent_span_id": {
        "anyOf": [
          {
            "pattern": "^[a-zA-Z0-9_-]{1,96}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
