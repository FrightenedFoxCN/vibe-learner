{
  "event": {
    "$defs": {
      "DiagnosticDesktopMetricV1": {
        "additionalProperties": false,
        "properties": {
          "instance_id": {
            "pattern": "^desktop-[a-f0-9-]{1,88}$",
            "title": "Instance Id",
            "type": "string"
          },
          "exit_code": {
            "anyOf": [
              {
                "maximum": 2147483647,
                "minimum": -2147483648,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Exit Code"
          },
          "dropped_before": {
            "minimum": 0,
            "title": "Dropped Before",
            "type": "integer"
          },
          "write_failures_before": {
            "minimum": 0,
            "title": "Write Failures Before",
            "type": "integer"
          }
        },
        "required": [
          "instance_id",
          "dropped_before",
          "write_failures_before"
        ],
        "title": "DiagnosticDesktopMetricV1",
        "type": "object"
      },
      "DiagnosticHarnessReferenceV1": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "pattern": "^harness-operation-[0-9a-f]{32}$",
            "title": "Operation Id",
            "type": "string"
          },
          "workflow": {
            "$ref": "#/$defs/HarnessWorkflow"
