              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model Gap"
          },
          "timeout_seconds": {
            "minimum": 0,
            "title": "Timeout Seconds",
            "type": "integer"
          },
          "max_attempts": {
            "const": 3,
            "default": 3,
            "title": "Max Attempts",
            "type": "integer"
          },
          "attempt_index": {
            "anyOf": [
              {
                "maximum": 3,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Attempt Index"
          },
          "attempts_used": {
            "maximum": 3,
            "minimum": 0,
            "title": "Attempts Used",
            "type": "integer"
          },
          "recovered": {
            "default": false,
            "title": "Recovered",
            "type": "boolean"
          },
          "input_tokens": {
            "anyOf": [
              {
                "maximum": 1000000000000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "maximum": 1000000000000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Output Tokens"
          },
          "total_tokens": {
            "anyOf": [
              {
                "maximum": 1000000000000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Tokens"
          },
          "usage_source": {
            "enum": [
              "provider_reported",
              "unavailable"
            ],
            "title": "Usage Source",
            "type": "string"
          },
          "usage_gap": {
            "anyOf": [
              {
                "enum": [
                  "not_returned",
                  "partial_or_invalid",
                  "aggregate_not_additive"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Usage Gap"
          },
          "cost": {
            "default": null,
            "title": "Cost",
            "type": "null"
          },
          "cost_gap": {
            "const": "provider_cost_evidence_unavailable",
            "default": "provider_cost_evidence_unavailable",
            "title": "Cost Gap",
            "type": "string"
          },
          "configuration_gap": {
            "const": "endpoint_configuration_not_recorded",
            "default": "endpoint_configuration_not_recorded",
            "title": "Configuration Gap",
            "type": "string"
          }
        },
        "required": [
          "request_kind",
          "timeout_seconds",
          "attempts_used",
          "usage_source"
        ],
        "title": "DiagnosticProviderMetricV1",
        "type": "object"
      },
      "DiagnosticResourceReferenceV1": {
        "additionalProperties": false,
        "properties": {
          "resource_type": {
            "const": "persona",
            "title": "Resource Type",
            "type": "string"
          },
          "resource_id": {
            "pattern": "^[A-Za-z0-9:._-]{1,160}$",
            "title": "Resource Id",
            "type": "string"
          },
          "revision": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Revision"
          }
        },
        "required": [
          "resource_type",
          "resource_id"
        ],
        "title": "DiagnosticResourceReferenceV1",
        "type": "object"
      },
      "DiagnosticToolMetricV1": {
        "additionalProperties": false,
        "properties": {
          "workflow": {
            "$ref": "#/$defs/HarnessWorkflow"
          },
          "offered_in_stage": {
            "$ref": "#/$defs/HarnessStage"
          },
          "execution_stage": {
            "anyOf": [
              {
                "$ref": "#/$defs/HarnessStage"
              },
              {
                "type": "null"
              }
            ],
            "default": null
