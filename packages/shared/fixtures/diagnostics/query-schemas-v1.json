          "trace_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9:._-]{1,160}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Trace Id"
          },
          "attempt_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9:._-]{1,160}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Attempt Id"
          },
          "attempt_index": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Attempt Index"
          },
          "phase": {
            "anyOf": [
              {
                "$ref": "#/$defs/HarnessAttemptPhase"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "attempt_status": {
            "anyOf": [
              {
                "$ref": "#/$defs/HarnessAttemptStatus"
              },
              {
                "type": "null"
              }
            ],
            "default": null
