        },
        "required": [
          "operation_id",
          "workflow",
          "stage"
        ],
        "title": "DiagnosticHarnessReferenceV1",
        "type": "object"
      },
      "DiagnosticProviderMetricV1": {
        "additionalProperties": false,
        "properties": {
          "adapter": {
            "const": "litellm",
            "default": "litellm",
            "title": "Adapter",
            "type": "string"
          },
          "adapter_contract": {
            "const": "diagnostic-provider-transport-v1",
            "default": "diagnostic-provider-transport-v1",
            "title": "Adapter Contract",
            "type": "string"
          },
          "request_kind": {
            "enum": [
              "plan",
              "chat",
              "setting",
              "embedding",
              "other"
            ],
            "title": "Request Kind",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model"
          },
          "model_gap": {
            "anyOf": [
              {
                "const": "model_label_unreviewed",
