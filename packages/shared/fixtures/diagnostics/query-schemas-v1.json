        "type": "string"
      },
      "HarnessStage": {
        "enum": [
          "document_parse",
          "page_extraction",
          "section_detection",
          "chunk_building",
          "ocr_page",
          "study_unit_cleanup",
          "plan_generation",
          "planning_tool_execution",
          "persona_generation",
          "scene_generation",
          "study_chat_reply",
          "actor_reply",
          "response_decode"
        ],
        "title": "HarnessStage",
        "type": "string"
      },
      "HarnessWorkflow": {
        "enum": [
          "document_parse",
          "ocr",
          "study_unit_cleanup",
          "planning",
          "persona",
          "scene",
          "study_chat",
          "tavern",
          "frontend_decode"
        ],
        "title": "HarnessWorkflow",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "diagnostic-event-v1",
