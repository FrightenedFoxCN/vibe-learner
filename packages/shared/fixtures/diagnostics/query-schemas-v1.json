      "page_view_id": {
        "anyOf": [
          {
            "pattern": "^[a-zA-Z0-9_-]{1,96}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Page View Id"
      },
      "flow_id": {
        "anyOf": [
          {
            "pattern": "^[a-zA-Z0-9_-]{1,96}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Flow Id"
      },
      "action_id": {
        "anyOf": [
          {
            "pattern": "^[a-zA-Z0-9_-]{1,96}$",
