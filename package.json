{
  "name": "vibe-learner",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @vibe-learner/web run dev",
    "build:web": "npm --workspace @vibe-learner/web run build",
    "build:desktop:web": "npm --workspace @vibe-learner/web run build:desktop",
    "prepare:desktop:bundle": "npm --workspace @vibe-learner/desktop run prepare:bundle",
    "dev:desktop": "npm --workspace @vibe-learner/desktop run dev",
    "build:desktop": "npm --workspace @vibe-learner/desktop run build",
    "check:web": "npm --workspace @vibe-learner/web run check",
    "lint:web": "npm run check:web",
    "test:contracts": "tsc -p packages/shared/tsconfig.json && tsc -p packages/shared/tsconfig.contracts.json && node packages/shared/tests/harness-policy-registry.mjs",
    "test:web:tavern": "npm --workspace @vibe-learner/web run test:tavern",
    "test:web:reliability": "npm --workspace @vibe-learner/web run test:reliability",
    "test:ai": "cd services/ai && UV_CACHE_DIR=/tmp/vibe-learner-uv-cache uv run python -m unittest discover -s tests",
    "test": "npm run test:ai",
    "check": "npm run test:contracts && npm run check:web && npm run test:web:reliability",
    "check:release": "npm run check && npm run test:ai && npm run build:web"
  },
  "dependencies": {
    "rehype-katex": "^7.0.1"
  }
}
